{
  "name": "aom-build-order-builder",
  "private": true,
  "version": "0.1.0",
  "description": "Build order builder and simulator for Age of Mythology: Retold",
  "license": "MIT",
  "author": "Bruno Pena Baeta (IKazart)",
  "homepage": "https://brunopb.github.io/AoMBuildOrderBuilder/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrunoPB/AoMBuildOrderBuilder.git"
  },
  "bugs": {
    "url": "https://github.com/BrunoPB/AoMBuildOrderBuilder/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/build-api.ts",
    "preview": "vite preview",
    "build-api": "tsx scripts/build-api.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check-data": "tsx scripts/check-data.ts",
    "game-icons": "python scripts/game-icons.py",
    "compare:krush": "tsx scripts/compare-krush.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "preact": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
